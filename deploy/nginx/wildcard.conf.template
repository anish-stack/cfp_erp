# Generated by deploy/setup-sites.sh — any other *.__ZONE__ host (wildcard DNS) without its own site.
# Wildcard server_name has LOWER priority than exact names, so your other apps' sites are untouched.
server {
  listen 80;
  server_name *.__ZONE__;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name *.__ZONE__;
  ssl_certificate     __SSL_CERT__;
  ssl_certificate_key __SSL_KEY__;
  ssl_protocols TLSv1.2 TLSv1.3;
  default_type text/html;
  location / { return 404 '<!doctype html><meta charset="utf-8"><title>Not found</title><body style="font-family:system-ui;display:grid;place-items:center;height:90vh;color:#555"><div><h1 style="margin:0">404</h1><p>$host is not configured.</p></div>'; }
}
