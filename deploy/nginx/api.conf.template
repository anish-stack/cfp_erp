# Generated by deploy/setup-sites.sh — API (__HOST__) → Node on 127.0.0.1:__PORT__
upstream cpf_api { server 127.0.0.1:__PORT__; keepalive 32; }

server {
  listen 80;
  server_name __HOST__;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name __HOST__;
  ssl_certificate     __SSL_CERT__;
  ssl_certificate_key __SSL_KEY__;
  ssl_protocols TLSv1.2 TLSv1.3;

  client_max_body_size 50m;   # CMS video uploads (40 MB max)
  add_header Strict-Transport-Security "max-age=31536000" always;

  location / {
    proxy_pass http://cpf_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    # $remote_addr is the real visitor IP (cloudflare-realip.conf); Cloudflare geo headers (cf-ipcity …) pass through
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 60s;
  }
}
