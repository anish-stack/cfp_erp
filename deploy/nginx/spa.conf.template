# Generated per SPA by setup-sites.sh (__HOST__ / __ROOT__ replaced).
# console/dist serves admin., clinic. and crm. — mode comes from the subdomain.
server {
  listen 80;
  server_name __HOST__;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name __HOST__;
  ssl_certificate     /etc/letsencrypt/live/centreforpilesandfistula.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/centreforpilesandfistula.com/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;

  root __ROOT__;
  index index.html;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # PWA: service worker + manifest must always revalidate
  location = /sw.js {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
    add_header Service-Worker-Allowed "/";
    try_files $uri =404;
  }
  location = /manifest.webmanifest {
    default_type application/manifest+json;
    add_header Cache-Control "no-cache";
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
