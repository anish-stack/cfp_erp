# ─────────────────────────────────────────────────────────────────────────────
# ONE place for every host name. setup-sites.sh, build-frontend.sh and the
# backend .env example all read from here. Change and re-run the scripts.
# Cloudflare free plan: keep every host ONE level under the zone
# (apicfp.hovermessage.com ✓, admin.cfp.hovermessage.com ✗ — not covered by Universal SSL).
# ─────────────────────────────────────────────────────────────────────────────
ZONE=hovermessage.com
API_HOST=apicfp.hovermessage.com        # backend API (Node, PM2)
BOOKING_HOST=cfp.hovermessage.com       # patient booking portal + CMS landing pages (/f/<slug>)
ADMIN_HOST=admincfp.hovermessage.com    # console — Super Admin mode
CLINIC_HOST=cliniccfp.hovermessage.com  # console — Clinic mode (reception, doctors, IPD, billing)
CRM_HOST=crmcfp.hovermessage.com        # console — Sales CRM mode

APP_DIR=/var/www/cpf-erp
API_PORT=5050                           # must equal PORT in backend/.env (5050 avoids clashing with other apps on this VPS)

# Cloudflare Origin Certificate (SSL/TLS → Origin Server → Create, hosts: hovermessage.com, *.hovermessage.com)
SSL_CERT=/etc/ssl/cloudflare/hovermessage.com.pem
SSL_KEY=/etc/ssl/cloudflare/hovermessage.com.key

# 1 = answer every other *.hovermessage.com host that has no site of its own with a 404 page
#     (needed once the wildcard DNS record exists). Exact host names of your other apps still win.
WILDCARD_CATCHALL=1
