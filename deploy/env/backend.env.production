# Copy to backend/.env on the server:  cp deploy/env/backend.env.production backend/.env && nano backend/.env
# Fill every <…>. Generate secrets: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
NODE_ENV=production
PORT=5050
APP_NAME=Centre for Piles & Fistula

# MongoDB replica set (transactions). Own database name so it never mixes with your other apps.
MONGO_URI=mongodb://cpf:<mongo-password>@127.0.0.1:27017/cpf_erp?replicaSet=rs0&authSource=cpf_erp
# Redis: use a SEPARATE db number (/3) so queues don't mix with other apps on the same Redis
REDIS_URL=redis://:<redis-password>@127.0.0.1:6379/3

JWT_ACCESS_SECRET=<96-hex>
JWT_REFRESH_SECRET=<96-hex>
JWT_PATIENT_SECRET=<96-hex>
CONFIG_SECRET=<96-hex>
DOC_LINK_SECRET=<96-hex>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_PATIENT_TTL=30d

# every frontend host (deploy/domains.env)
CORS_ORIGINS=https://cfp.hovermessage.com,https://admincfp.hovermessage.com,https://cliniccfp.hovermessage.com,https://crmcfp.hovermessage.com
# EMPTY = login cookie only for apicfp.hovermessage.com (does not leak to your other *.hovermessage.com apps)
COOKIE_DOMAIN=

PUBLIC_API_URL=https://apicfp.hovermessage.com
BOOKING_URL=https://cfp.hovermessage.com
UPLOAD_DIR=/root/cfp_erp/backend/uploads

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_PER_HOUR=5
OTP_CHANNEL=whatsapp

SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=<admin email>
SEED_ADMIN_PHONE=<10-digit mobile>
SEED_ADMIN_PASSWORD=<strong password — change after first login>

WEBSITE_API_KEY=<random 32+ chars>

# Can also be set later in Console → Settings → Integrations (stored encrypted in the DB)
WAPP_API_URL=https://api.wtap.sms4power.com/wapp/v2/api/send
WAPP_API_KEY=
WAPP_COUNTRY=IN
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
