NODE_ENV=development
PORT=5000
APP_NAME=Centre for Piles & Fistula

# Mongo must be a replica set for transactions (single-node rs0 is fine)
MONGO_URI=mongodb://127.0.0.1:27017/cpf_erp?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379

# generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_PATIENT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_PATIENT_TTL=30d

# comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
# prod: .centreforpilesandfistula.com   (leave empty for localhost)
COOKIE_DOMAIN=

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_PER_HOUR=5
# dev only: prints OTP to API log. Ignored when NODE_ENV=production
OTP_DEV_LOG=true

# SMS (MSG91 DLT) — optional OTP fallback when OTP_CHANNEL=sms|both
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=

# seed super admin
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@centreforpilesandfistula.com
# super admin can also log in with this mobile
SEED_ADMIN_PHONE=9212395788
SEED_ADMIN_PASSWORD=

# ---------- files ----------
UPLOAD_DIR=./uploads
PUBLIC_API_URL=http://localhost:5000
BOOKING_URL=http://localhost:5173

# server-to-server lead push from main website (POST /api/v1/public/leads, header x-api-key)
WEBSITE_API_KEY=

# ---------- WhatsApp (sms4power WAPP API) ----------
# https recommended (API key travels in the query string). Use the http:// URL only if https is refused.
WAPP_API_URL=https://api.wtap.sms4power.com/wapp/v2/api/send
WAPP_API_KEY=
WAPP_COUNTRY=IN
# whatsapp | sms | both   (sms uses MSG91 OTP API below)
OTP_CHANNEL=whatsapp

# signed public PDF links sent on WhatsApp (invoice / prescription). 48+ random chars.
DOC_LINK_SECRET=
DOC_LINK_TTL_DAYS=30

# ---------- Exotel (CRM dialer, IVR, call recordings) ----------
# Dashboard → Settings → API: SID, API key, API token. Region host: api.exotel.com (Singapore) or api.in.exotel.com (Mumbai)
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
# your ExoPhone (virtual number customers see / call)
EXOTEL_CALLER_ID=
# random 32+ chars; appended as ?t= to every Exotel callback URL
EXOTEL_WEBHOOK_TOKEN=

# ---------- MSG91 transactional flows (DLT) ----------
MSG91_FLOW_APPT=
MSG91_FLOW_REMINDER=

# ---------- SMTP ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# comma-separated recipients for daily stock alerts
ALERT_EMAILS=

# Integration keys below (storage, SMTP, Exotel, WhatsApp, APP_NAME) can also be set from
# Console → Settings → Integrations; saved values override this file. Secrets there are encrypted with:
CONFIG_SECRET=

# ---------- Media storage (CMS / landing page images & videos) ----------
# auto = first configured of R2 → S3 → Cloudinary, otherwise local disk (UPLOAD_DIR/media, served at /media)
STORAGE_DRIVER=auto
# AWS S3 (bucket must allow public read on the media/ prefix, or use S3_PUBLIC_URL = CloudFront)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL=
# Cloudflare R2 (enable public access via r2.dev or a custom domain, put it in R2_PUBLIC_URL)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cpf

# ---------- Hugging Face AI (CMS landing page writer) — also editable in Settings → Integrations ----------
# token: huggingface.co → Settings → Access Tokens (fine-grained, "Make calls to Inference Providers")
HF_TOKEN=
HF_MODEL=auto
HF_API_URL=https://router.huggingface.co/v1/chat/completions
